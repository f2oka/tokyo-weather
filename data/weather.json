TZ = "Asia/Tokyo"
VARS = "temperature_2m_max,temperature_2m_min,temperature_2m_mean,weather_code,precipitation_sum"


def fetch_json_with_retry(url, retries=3, delay=5):
  for i in range(retries):
    try:
      req = urllib.request.Request(
          url, headers={"User-Agent": "TokyoWeatherBot/1.0"}
      )
      with urllib.request.urlopen(req, timeout=30) as res:
        return json.loads(res.read().decode("utf-8"))
    except Exception as e:
      print(f"取得失敗 ({i+1}/{retries}): {e}")
      if i < retries - 1:
        time.sleep(delay)
      else:
        raise e


def records_from_daily(daily):
  if not daily or "time" not in daily:
    return {}
  t = daily["time"]
  out = {}
  for i, d in enumerate(t):
    out[d] = {
        "date": d,
        "t_max": (
            daily["temperature_2m_max"][i]
            if "temperature_2m_max" in daily
            else None
        ),
        "t_min": (
            daily["temperature_2m_min"][i]
            if "temperature_2m_min" in daily
            else None
        ),
        "t_mean": (
            daily["temperature_2m_mean"][i]
            if "temperature_2m_mean" in daily
            else None
        ),
        "weather_code": (
            daily["weather_code"][i] if "weather_code" in daily else None
        ),
        "precip": (
            daily["precipitation_sum"][i]
            if "precipitation_sum" in daily
            else None
        ),
    }
  return out


def main():
  all_data = {}
  jst = timezone(timedelta(hours=9))
  today = datetime.now(jst)

  # 昨年の同期間の計算
  end_date = today - timedelta(days=365)
  start_date = end_date - timedelta(days=400)  # 多めに約1年分取得

  for city in CITIES:
    print(f"取得中: {city['id']}...")
    try:
      # 最近のデータ
      recent_url = f"https://api.open-meteo.com/v1/forecast?latitude={city['lat']}&longitude={city['lon']}&daily={VARS}&timezone={TZ}&past_days=35&forecast_days=1"
      recent_res = fetch_json_with_retry(recent_url)

      # 昨年のデータ
      ly_url = f"https://historical-forecast-api.open-meteo.com/v1/forecast?latitude={city['lat']}&longitude={city['lon']}&daily={VARS}&timezone={TZ}&start_date={start_date.strftime('%Y-%m-%d')}&end_date={end_date.strftime('%Y-%m-%d')}"
      ly_res = fetch_json_with_retry(ly_url)

      merged = {
          **records_from_daily(ly_res.get("daily")),
          **records_from_daily(recent_res.get("daily")),
      }
      all_data[city["id"]] = merged
      time.sleep(0.5)  # サーバー負荷軽減のウェイト
    except Exception as e:
      print(f"❌ {city['id']} の取得に失敗しました: {e}")

  os.makedirs("data", exist_ok=True)
  with open("data/weather.json", "w", encoding="utf-8") as f:
    json.dump(all_data, f, ensure_ascii=False, separators=(",", ":"))
  print("✅ data/weather.json の保存が完了しました。")


if __name__ == "__main__":
  main()
